rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStudioMember(studioId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/studios/$(studioId)/members/$(request.auth.uid));
    }

    function isStudioOwner(studioId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/studios/$(studioId)).data.ownerUid == request.auth.uid;
    }

    function isStudioOwnerAfter(studioId) {
      return isSignedIn() &&
        getAfter(/databases/$(database)/documents/studios/$(studioId)).data.ownerUid == request.auth.uid;
    }

    function assignmentAllowsStudent(studioId, assignmentId, uid) {
      let assignment = get(/databases/$(database)/documents/studios/$(studioId)/assignments/$(assignmentId)).data;
      return assignment.target == "studio"
        || (assignment.target == "individual" && assignment.targetStudentUid == uid);
    }

    function touchesRestrictedUserFieldsOnCreate() {
      return request.resource.data.keys().hasAny([
        "isPro",
        "hasLifetimePro",
        "entitlementTier",
        "trialUsed",
        "trialStartedAt",
        "trialEndsAt",
        "proSince",
        "isMasterAccount",
        "canSwitchRoleFreely"
      ]);
    }

    function touchesRestrictedUserFieldsOnUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        "isPro",
        "hasLifetimePro",
        "entitlementTier",
        "trialUsed",
        "trialStartedAt",
        "trialEndsAt",
        "proSince",
        "isMasterAccount",
        "canSwitchRoleFreely"
      ]);
    }

    function isValidDisplayName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 30
        && name.matches("^[\\p{L}\\p{N}._'\\- ]+$")
        && name.matches('.*[\\p{L}\\p{N}].*');
    }

    function validDisplayNameOnCreate() {
      return !("displayName" in request.resource.data) || isValidDisplayName(request.resource.data.displayName);
    }

    function validDisplayNameOnUpdate() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(["displayName"])
        || isValidDisplayName(request.resource.data.displayName);
    }

    function changesServerOwnedIdentityFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        "handle",
        "dateOfBirth",
        "ageBand",
        "profileSchemaVersion",
        "handleChangedAt",
        "profilePrivacy"
      ]);
    }

    function areAcceptedFriends(otherUID) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/friendships/$(request.auth.uid)/buddies/$(otherUID))
        && exists(/databases/$(database)/documents/friendships/$(otherUID)/buddies/$(request.auth.uid));
    }

    match /users/{uid} {
      // The private account document never powers search, social profiles, or
      // leaderboards. Those read the server-owned publicProfiles projection.
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && !touchesRestrictedUserFieldsOnCreate()
        && validDisplayNameOnCreate();
      allow update: if isSelf(uid)
        && !touchesRestrictedUserFieldsOnUpdate()
        && !changesServerOwnedIdentityFields()
        && validDisplayNameOnUpdate();
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      // Cloud Functions are the only writers, so birth date, contact details,
      // entitlements, and migration internals cannot leak through this data.
      allow create, update, delete: if false;
    }

    match /handles/{handle} {
      allow read, write: if false;
    }

    match /handleRedirects/{handle} {
      allow read, write: if false;
    }

    match /presence/{uid} {
      allow read: if isSelf(uid) || areAcceptedFriends(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(["presenceState", "presenceLastChanged", "updatedAt"])
        && request.resource.data.presenceState in ["online", "offline"];
      allow delete: if isSelf(uid);
    }

    match /feedInboxes/{uid}/items/{momentID} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    match /practiceMoments/{momentID} {
      allow get: if isSignedIn() && (
        resource.data.authorUID == request.auth.uid ||
        exists(/databases/$(database)/documents/feedInboxes/$(request.auth.uid)/items/$(momentID))
      ) && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /practiceMoments/{momentID}/reactions/{uid} {
      allow read: if isSignedIn() && (
        uid == request.auth.uid ||
        exists(/databases/$(database)/documents/feedInboxes/$(request.auth.uid)/items/$(momentID))
      );
      allow create, update, delete: if false;
    }

    match /socialFollows/{relationshipID} {
      allow read, write: if false;
    }

    match /followRequests/{requestID} {
      allow read, write: if false;
    }

    match /socialBlocks/{blockID} {
      allow read, write: if false;
    }

    match /contentReports/{reportID} {
      allow read, write: if false;
    }

    match /users/{uid}/devices/{deviceId} {
      allow read, create, update, delete: if isSelf(uid);
    }

    match /duelChallenges/{challengeId} {
      allow read: if isSignedIn() &&
        (
          resource.data.status == "open"
          || request.auth.uid in resource.data.participants
        );

      // Server-authoritative duel state: only Cloud Functions writes duel docs.
      allow create, update, delete: if false;
    }

    match /duelChallenges/{challengeId}/attempts/{uid} {
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/duelChallenges/$(challengeId)) &&
        request.auth.uid in get(/databases/$(database)/documents/duelChallenges/$(challengeId)).data.participants;
      // Attempt writes are server-authoritative via Cloud Functions.
      allow create, update, delete: if false;
    }

    match /duelQueue/{uid} {
      allow read: if isSelf(uid);
      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      // Only sender can create an invite from themselves.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == "pending";

      // Sender or recipient can update invite status.
      allow update: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{uid}/buddies/{buddyUid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) || request.auth.uid == buddyUid;
      allow delete: if isSelf(uid) || request.auth.uid == buddyUid;
    }

    match /friendChats/{threadId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2;
      allow update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
    }

    match /friendChats/{threadId}/messages/{messageId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/friendChats/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/friendChats/$(threadId)).data.participants;
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/friendChats/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/friendChats/$(threadId)).data.participants
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /studios/{studioId} {
      // MVP: signed-in users can read studio metadata so invite-code lookup works.
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isStudioOwner(studioId);
    }

    match /studios/{studioId}/members/{uid} {
      allow read: if isStudioMember(studioId);

      // Teacher can add members; student can join themselves with student role.
      allow create: if isStudioOwner(studioId)
        || isStudioOwnerAfter(studioId)
        || (isSelf(uid)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == "student");

      allow update, delete: if isStudioOwner(studioId) || isSelf(uid);
    }

    match /studios/{studioId}/assignments/{assignmentId} {
      allow read: if isStudioMember(studioId);
      allow create, update, delete: if isStudioOwner(studioId);
    }

    match /studios/{studioId}/assignments/{assignmentId}/submissions/{uid} {
      allow read: if isStudioMember(studioId);
      allow create, update, delete: if isStudioOwner(studioId)
        || (isSelf(uid) && assignmentAllowsStudent(studioId, assignmentId, request.auth.uid));
    }

    match /studios/{studioId}/planTemplates/{templateId} {
      allow read: if isStudioMember(studioId);
      allow create, update, delete: if isStudioOwner(studioId);
    }

    match /studios/{studioId}/warmups/{warmupId} {
      allow read: if isStudioMember(studioId);
      allow create, update, delete: if isStudioOwner(studioId);
    }

    match /studios/{studioId}/events/{eventId} {
      allow read: if isStudioMember(studioId);
      allow create, update, delete: if isStudioOwner(studioId);
    }

    match /studios/{studioId}/lessonTemplates/{templateId} {
      allow read: if isStudioMember(studioId);
      allow create, update, delete: if isStudioOwner(studioId);
    }

    match /studios/{studioId}/messages/{messageId} {
      allow read: if isStudioMember(studioId);
      allow create: if isStudioMember(studioId)
        && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if isStudioOwner(studioId)
        || (isSignedIn() && resource.data.senderUid == request.auth.uid);
    }
  }
}
