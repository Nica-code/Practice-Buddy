      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구 프로필은 커뮤니티, 결투, 클라우드 연결 ID에만 필요합니다. 그것 없이도 개인 연습은 계속 가능합니다."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil permanent este necesar numai pentru comunitate, dueluri și identitate legată de cloud. Practica privată rămâne disponibilă fără ea."
          }
        }
      }
    },
