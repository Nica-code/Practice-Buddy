    "A duel was accepted. Enter when you are ready to record your take." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결투가 수락되었습니다. 테이크를 녹음할 준비가 되면 입력하세요."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S-a acceptat un duel. Intră când ești gata să-ți înregistrezi tentativa."
          }
        }
      }
    },
    "A focused practice world for musicians." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음악가를 위한 집중적인 연습의 세계."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O lume de practică concentrată pentru muzicieni."
          }
        }
      }
    },
    "A generated card—never your notes, audio, or reflection." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생성된 카드 - 메모, 오디오 또는 반사가 아닙니다."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un card generat - niciodată notele, sunetul sau reflecția dvs."
          }
        }
      }
    },
    "A newer version (%@) is available. Please update to continue." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 버전(%@)을 사용할 수 있습니다. 계속하려면 업데이트하세요."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este disponibilă o versiune mai nouă (%@). Actualizați pentru a continua."
          }
        }
      }
    },
    "A plan shaped by your private practice history." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 개인 진료 이력을 바탕으로 수립된 계획입니다."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan modelat de istoricul practicii dumneavoastră private."
          }
        }
      }
    },
    "A polished card without private reflections." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사적인 반사가 없는 세련된 카드입니다."
          }
        },
        "ro" : {
