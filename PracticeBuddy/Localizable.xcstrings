    },
    "A generated card—never your notes, audio, or reflection.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 카드 - 메모, 오디오 또는 반사가 아닙니다."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un card generat - niciodată notele, sunetul sau reflecția dvs."
          }
        }
      }
    },
    "A monthly token allowance and premium collections.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월별 토큰 수당 및 프리미엄 컬렉션."
