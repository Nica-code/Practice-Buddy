    "Follow a guided pitch path and see where centering, stability, and repeated scale degrees need attention.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안내된 피치 경로를 따라 센터링, 안정성 및 반복되는 스케일 각도에 주의가 필요한 부분을 확인하세요."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmați o cale de pas ghidată și vedeți unde centrarea, stabilitatea și gradele repetate de scară necesită atenție."
          }
        }
      }
    },
